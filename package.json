{
  "name": "pulse-arena-f1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pulse Arena — Formula 1 Telegram Mini App (DEMO contour frontend)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "circuits": "node scripts/build-circuits.mjs"
  },
  "dependencies": {
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "flag-icons": "^7.6.0",
    "jsdom": "^30.1.3",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
